<view class="container">
  <input class="search" placeholder="搜索方名 / 证型 / 症状关键词" value="{{kw}}" bindinput="onKw" />
  <view class="chips" style="margin-bottom:16rpx;">
    <view class="chip {{meridian === '全部' ? 'on' : ''}}" data-v="全部" bindtap="setMeridian">全部</view>
    <view wx:for="{{MERIDIANS}}" wx:key="*this" class="chip {{meridian === item ? 'on' : ''}}" data-v="{{item}}" bindtap="setMeridian">{{item}}</view>
  </view>

  <view class="empty" wx:if="{{!list.length}}">没有符合条件的方剂</view>

  <view class="panel row" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="left">
      <view class="name">{{item.name}} <text class="diff d-{{item.difficulty}}">{{item.difficulty}}</text></view>
      <view style="margin-top:10rpx;">
        <view wx:for="{{item.meridians}}" wx:for-item="m" wx:key="*this" class="badge {{M_CLASS[m]}}">{{m}}</view>
        <text class="sub">{{item.subPattern}}</text>
      </view>
    </view>
    <view class="st st-{{item.st}}">{{item.status}}</view>
  </view>
</view>
