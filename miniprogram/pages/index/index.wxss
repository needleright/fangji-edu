.hero {
  background: linear-gradient(135deg, #3E6B4F, #2E523C);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { font-size: 24rpx; opacity: 0.85; margin-top: 10rpx; }
.hero-stats { display: flex; margin-top: 36rpx; }
.hs-item { flex: 1; text-align: center; }
.hs-num { font-size: 44rpx; font-weight: 700; }
.hs-label { font-size: 22rpx; opacity: 0.8; margin-top: 4rpx; }

.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.cell {
  width: 48.5%;
  border-radius: 20rpx;
  padding: 32rpx 26rpx;
  margin-bottom: 20rpx;
  color: #fff;
  box-sizing: border-box;
}
.c1 { background: linear-gradient(135deg, #4C9E6B, #3E7D56); }
.c2 { background: linear-gradient(135deg, #D9834F, #C4693B); }
.c3 { background: linear-gradient(135deg, #3B82C4, #2F6AA3); }
.c4 { background: linear-gradient(135deg, #B04030, #93342A); }
.cell-t { font-size: 34rpx; font-weight: 600; }
.cell-d { font-size: 22rpx; opacity: 0.85; margin-top: 8rpx; }

.list-entry { display: flex; justify-content: space-between; align-items: center; }
.arrow { font-size: 48rpx; color: #C9C0B0; }
.tip { text-align: center; font-size: 22rpx; color: #B5AC9C; margin: 30rpx 0; }
