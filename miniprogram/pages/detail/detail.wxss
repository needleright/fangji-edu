.head { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 44rpx; font-weight: 700; }
.fav { font-size: 26rpx; color: #9B9284; }
.fav.on { color: #E0A93E; }
.sec-t { font-size: 27rpx; font-weight: 600; color: #3E6B4F; margin-bottom: 12rpx; margin-top: 8rpx; }
.txt { font-size: 27rpx; line-height: 1.8; color: #3A3226; margin-bottom: 16rpx; }
.herbs { display: flex; flex-wrap: wrap; }
.herb {
  background: #F4F0E6; border-radius: 10rpx;
  padding: 10rpx 20rpx; font-size: 25rpx;
  margin: 0 12rpx 12rpx 0; color: #5A4E3A;
}
.variant {
  font-size: 26rpx; color: #5A4E3A; line-height: 1.7;
  background: #FBF9F3; border-left: 6rpx solid #C29A3F;
  padding: 14rpx 20rpx; border-radius: 0 10rpx 10rpx 0;
  margin-bottom: 14rpx;
}
.diff-chip { background: #E4F0E8; color: #3E6B4F; }
