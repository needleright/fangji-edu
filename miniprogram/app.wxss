/* 全局样式 —— 中医纸墨风 */
page {
  background: #F7F4EE;
  color: #3A3226;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container { padding: 24rpx; }

/* 通用卡片 */
.panel {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(90, 70, 40, 0.06);
}

/* 筛选 chips */
.chips { display: flex; flex-wrap: wrap; }
.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #EFEAE0;
  color: #6B5F4C;
  font-size: 24rpx;
  margin: 0 14rpx 14rpx 0;
}
.chip.on { background: #3E6B4F; color: #fff; }

/* 六经徽章 */
.badge {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  margin-right: 10rpx;
}
.m-taiyang { background: #3B82C4; }
.m-yangming { background: #D9553F; }
.m-shaoyang { background: #4C9E6B; }
.m-taiyin { background: #C29A3F; }
.m-shaoyin { background: #5B4FA8; }
.m-jueyin { background: #8A4FA8; }

/* 难度 */
.diff { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 8rpx; }
.d-入门 { background: #E4F0E8; color: #3E6B4F; }
.d-进阶 { background: #FBF0DC; color: #A8762A; }
.d-难点 { background: #FAE3DE; color: #B04030; }

/* 主按钮 */
.btn-main {
  background: #3E6B4F;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-main.disabled { opacity: 0.4; }
.btn-line {
  border: 2rpx solid #3E6B4F;
  color: #3E6B4F;
  border-radius: 16rpx;
  font-size: 30rpx;
  padding: 18rpx 0;
  text-align: center;
  background: transparent;
}

.title { font-size: 34rpx; font-weight: 600; color: #2F2A1F; }
.sub { font-size: 24rpx; color: #9B9284; }
.empty { text-align: center; color: #9B9284; padding: 120rpx 0; font-size: 26rpx; }
